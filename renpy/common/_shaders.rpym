init python:

    renpy.register_shader("renpy.geometry", glsl=300, variables="""
        uniform mat4 u_transform;
        in vec4 a_position;
    """,
    vertex_0="""
        gl_Position = a_position;
    """,
    vertex_100="""
        gl_Position = u_transform * gl_Position;
    """)

    renpy.register_shader("renpy.movie_yuv", glsl=300, private_uniforms=True, variables="""
        uniform sampler2D tex0;
        uniform sampler2D tex1;
        uniform mat3 u_movie_yuv_matrix;
        uniform vec3 u_movie_yuv_offset;
        in vec2 a_tex_coord;
        out vec2 v_tex_coord;
    """, vertex_200="""
        v_tex_coord = a_tex_coord;
    """, fragment_200="""
        float l__luma = texture(tex0, v_tex_coord).r;
        vec2 l__chroma = texture(tex1, v_tex_coord).ra;

        vec3 l__yuv = vec3(l__luma, l__chroma);
        vec3 l__rgb = u_movie_yuv_matrix * l__yuv + u_movie_yuv_offset;

        fragment_color = vec4(clamp(l__rgb, 0.0, 1.0), 1.0);
    """)

    renpy.register_shader("renpy.texture", glsl=300, variables="""
        uniform float u_lod_bias;
        uniform sampler2D tex0;
        in vec2 a_tex_coord;
        out vec2 v_tex_coord;
    """, vertex_200="""
        v_tex_coord = a_tex_coord;
    """, fragment_200="""
        fragment_color = texture(tex0, v_tex_coord, u_lod_bias);
    """)

    renpy.register_shader("renpy.gltf.unlit", glsl=300, variables="""
        uniform sampler2D u_tex_base_color;
        uniform vec4 u_color_base;
        uniform float u_material_base_color_texcoord;
        uniform vec3 u_material_base_color_uv0;
        uniform vec3 u_material_base_color_uv1;
        uniform float u_material_gltf_alphamode;
        uniform float u_material_gltf_alphacutoff;
        uniform float u_gltf_linear;
        in vec2 a_tex_coord;
        in vec2 a_tex_coord1;
        in vec4 a_color;
        out vec2 v__uv;
        out vec4 v__color;
    """, vertex_200="""
        vec3 uv = vec3(mix(a_tex_coord, a_tex_coord1, u_material_base_color_texcoord), 1.0);
        v__uv = vec2(dot(u_material_base_color_uv0, uv), dot(u_material_base_color_uv1, uv));
        v__color = clamp(a_color, 0.0, 1.0);
    """, fragment_200="""
        vec4 base = texture(u_tex_base_color, v__uv) * u_color_base * v__color;
        if (u_material_gltf_alphamode < 0.5) {
            base.a = 1.0;
        } else if (u_material_gltf_alphamode < 1.5) {
            if (base.a < u_material_gltf_alphacutoff) {
                discard;
            }
            base.a = 1.0;
        }
        vec3 linear_rgb = max(base.rgb, vec3(0.0));
        vec3 srgb = mix(12.92 * linear_rgb,
            1.055 * pow(linear_rgb, vec3(1.0 / 2.4)) - 0.055,
            step(vec3(0.0031308), linear_rgb));
        fragment_color = vec4(mix(srgb, linear_rgb, u_gltf_linear) * base.a, base.a);
    """)

    # GGX/Smith/Schlick and split-sum IBL: https://google.github.io/filament/Filament.md.html
    _gltf_brdf_functions = """
        float l__visibility(float nv, float nl, float a) {
            float aa = a * a;
            float gv = nl * sqrt(aa + (1.0 - aa) * nv * nv);
            float gl = nv * sqrt(aa + (1.0 - aa) * nl * nl);
            return 0.5 / max(gv + gl, 0.000001);
        }
        vec3 l__fresnel(float vh, vec3 f0, float f90) {
            return mix(f0, vec3(f90), pow(1.0 - vh, 5.0));
        }
        vec2 l__sphere_uv(vec3 d) {
            float longitude = dot(d.xz, d.xz) > 0.000000000001 ? atan(d.z, d.x) : 0.0;
            return vec2(longitude / 6.28318530718 + 0.5, acos(clamp(-d.y, -1.0, 1.0)) / 3.14159265359);
        }
        float gltf_cloth_curve(float cosine, float alpha) {
            float blend = (1.0 - alpha) * (1.0 - alpha);
            vec4 c = mix(vec4(21.5473, 3.82987, 0.19823, -1.97760),
                vec4(25.3245, 3.32435, 0.16801, -1.27393), blend);
            return c.x / (1.0 + c.y * pow(max(cosine, 0.0), c.z)) + c.w * cosine
                + mix(-4.32054, -4.85967, blend);
        }
        float gltf_cloth_lambda(float cosine, float alpha) {
            float exponent = cosine < 0.5 ? gltf_cloth_curve(cosine, alpha)
                : 2.0 * gltf_cloth_curve(0.5, alpha) - gltf_cloth_curve(1.0 - cosine, alpha);
            return exp(exponent);
        }
        float gltf_sheen_brdf(float nv, float nl, float nh, float roughness) {
            float alpha = max(roughness * roughness, 0.0001);
            float distribution = (2.0 + 1.0 / alpha) * pow(max(1.0 - nh * nh, 0.0), 0.5 / alpha)
                / 6.28318530718;
            float visibility = 1.0 / max(4.0 * nv * nl *
                (1.0 + gltf_cloth_lambda(nv, alpha) + gltf_cloth_lambda(nl, alpha)), 0.000001);
            return distribution * visibility;
        }
    """

    _gltf_specular_variables = """
        uniform float u_material_specular_factor;
        uniform vec3 u_material_specular_color_factor;
        uniform sampler2D u_tex_specular;
        uniform sampler2D u_tex_specular_color;
        uniform float u_material_specular_texcoord;
        uniform vec3 u_material_specular_uv0;
        uniform vec3 u_material_specular_uv1;
        uniform float u_material_specular_color_texcoord;
        uniform vec3 u_material_specular_color_uv0;
        uniform vec3 u_material_specular_color_uv1;
    """
    renpy.register_shader("renpy.gltf.specular", glsl=300, fragment_functions="#define GLTF_SPECULAR 1\n")

    _gltf_clearcoat_variables = """
        uniform float u_material_clearcoat_factor;
        uniform float u_material_clearcoat_roughness_factor;
        uniform float u_material_clearcoat_normal_scale;
        uniform float u_material_clearcoat_normals_present;
        uniform sampler2D u_tex_clearcoat;
        uniform sampler2D u_tex_clearcoat_roughness;
        uniform sampler2D u_tex_clearcoat_normals;
        uniform float u_material_clearcoat_texcoord;
        uniform vec3 u_material_clearcoat_uv0;
        uniform vec3 u_material_clearcoat_uv1;
        uniform float u_material_clearcoat_roughness_texcoord;
        uniform vec3 u_material_clearcoat_roughness_uv0;
        uniform vec3 u_material_clearcoat_roughness_uv1;
        uniform float u_material_clearcoat_normals_texcoord;
        uniform vec3 u_material_clearcoat_normals_uv0;
        uniform vec3 u_material_clearcoat_normals_uv1;
    """
    renpy.register_shader("renpy.gltf.clearcoat", glsl=300, fragment_functions="#define GLTF_CLEARCOAT 1\n")

    _gltf_sheen_variables = """
        uniform vec3 u_material_sheen_color_factor;
        uniform float u_material_sheen_roughness_factor;
        uniform sampler2D u_tex_sheen_color;
        uniform sampler2D u_tex_sheen_roughness;
        uniform float u_material_sheen_color_texcoord;
        uniform vec3 u_material_sheen_color_uv0;
        uniform vec3 u_material_sheen_color_uv1;
        uniform float u_material_sheen_roughness_texcoord;
        uniform vec3 u_material_sheen_roughness_uv0;
        uniform vec3 u_material_sheen_roughness_uv1;
    """
    renpy.register_shader("renpy.gltf.sheen", glsl=300, fragment_functions="#define GLTF_SHEEN 1\n")

    _gltf_cascade_variables = """
        uniform mat4 u_gltf_cascade_matrices[24];
        uniform float u_gltf_cascade_count;
        uniform vec4 u_gltf_cascade_splits;
        uniform float u_gltf_cascade_near;
        uniform vec3 u_gltf_cascade_eye;
        uniform vec3 u_gltf_cascade_forward;
    """
    renpy.register_shader("renpy.gltf.cascades", glsl=300, fragment_functions="#define GLTF_CASCADES 1\n")

    _gltf_glass_shadow_variables = """
        uniform sampler2D u_gltf_glass_color;
        uniform sampler2D u_gltf_glass_depth;
        uniform sampler2D u_gltf_caustics;
    """
    renpy.register_shader("renpy.gltf.colored_shadows", glsl=300, fragment_functions="#define GLTF_COLORED_SHADOWS 1\n")
    renpy.register_shader("renpy.gltf.caustics", glsl=300, fragment_functions="#define GLTF_CAUSTICS 1\n")

    renpy.register_shader("renpy.gltf.pbr", glsl=300, variables="""
        uniform mat4 u_model;
        uniform mat4 u_model_OP_inverse_transpose;
        uniform mat4 u_projection_OP_inverse;
        uniform mat4 u_view_OP_inverse;
        uniform mat4 u_projectionview;
        uniform sampler2D u_tex_base_color;
        uniform sampler2D u_tex_metalness;
        uniform sampler2D u_tex_normals;
        uniform sampler2D u_tex_lightmap;
        uniform sampler2D u_tex_emissive;
        uniform sampler2D u_tex_environment;
        uniform vec2 u_tex_environment_OP_res;
        uniform float u_gltf_environment_pages;
        uniform float u_gltf_probe_count;
        uniform vec4 u_gltf_probe_min[2];
        uniform vec4 u_gltf_probe_max[2];
        uniform vec4 u_gltf_probe_origin[2];
        uniform sampler2D u_tex_transmission;
        uniform sampler2D u_tex_thickness;
        uniform sampler2D u_gltf_background;
        uniform sampler2D u_gltf_background_depth;
        uniform vec2 u_gltf_background_OP_res;
        uniform float u_gltf_transmission_enabled;
        uniform float u_material_transmission_factor;
        uniform float u_material_thickness_factor;
        uniform float u_material_ior;
        uniform float u_material_attenuation_distance;
        uniform vec3 u_material_attenuation_color;
        uniform float u_material_transmission_texcoord;
        uniform vec3 u_material_transmission_uv0;
        uniform vec3 u_material_transmission_uv1;
        uniform float u_material_thickness_texcoord;
        uniform vec3 u_material_thickness_uv0;
        uniform vec3 u_material_thickness_uv1;
        uniform vec4 u_color_base;
        uniform float u_material_metallicfactor;
        uniform float u_material_roughnessfactor;
        uniform vec3 u_material_emissivefactor;
        uniform float u_material_emissive_strength;
        uniform float u_material_normal_scale;
        uniform float u_gltf_orthographic_camera;
        uniform float u_material_occlusion_strength;
        uniform float u_material_normals_present;
        uniform float u_material_unlit;
        uniform float u_material_twosided;
        uniform float u_material_gltf_alphamode;
        uniform float u_material_gltf_alphacutoff;
        uniform int u_gltf_light_count;
        uniform vec4 u_gltf_light_positions[8];
        uniform vec4 u_gltf_light_directions[8];
        uniform vec4 u_gltf_light_colors[8];
        uniform vec4 u_gltf_light_cones[8];
        uniform float u_gltf_meters_per_unit;
        uniform sampler2D u_gltf_shadow;
        uniform mat4 u_gltf_shadow_matrices[8];
        uniform vec4 u_gltf_shadow_data[8];
        uniform vec4 u_gltf_shadow_atlas;
        uniform float u_material_receive_shadows;
        uniform float u_gltf_environment_intensity;
        uniform float u_gltf_environment_rotation;
        uniform float u_material_base_color_texcoord;
        uniform vec3 u_material_base_color_uv0;
        uniform vec3 u_material_base_color_uv1;
        uniform float u_material_metalness_texcoord;
        uniform vec3 u_material_metalness_uv0;
        uniform vec3 u_material_metalness_uv1;
        uniform float u_material_normals_texcoord;
        uniform vec3 u_material_normals_uv0;
        uniform vec3 u_material_normals_uv1;
        uniform float u_material_lightmap_texcoord;
        uniform vec3 u_material_lightmap_uv0;
        uniform vec3 u_material_lightmap_uv1;
        uniform float u_material_emissive_texcoord;
        uniform vec3 u_material_emissive_uv0;
        uniform vec3 u_material_emissive_uv1;
        in vec2 a_tex_coord;
        in vec2 a_tex_coord1;
        in vec4 a_color;
        in vec3 a_normal;
        in vec3 a_tangent;
        in vec3 a_bitangent;
        in vec4 a_position;
        out vec2 v__uv0;
        out vec2 v__uv1;
        out vec4 v__color;
        out vec3 v__position;
        out vec3 v__normal;
        out vec3 v__tangent;
        out vec3 v__bitangent;
        out vec4 v__eye;
    """ + _gltf_specular_variables + _gltf_clearcoat_variables + _gltf_sheen_variables + _gltf_cascade_variables + _gltf_glass_shadow_variables, vertex_200="""
        v__uv0 = a_tex_coord;
        v__uv1 = a_tex_coord1;
        v__color = clamp(a_color, 0.0, 1.0);
        v__position = (u_model * a_position).xyz;
        v__normal = mat3(u_model_OP_inverse_transpose) * a_normal;
        v__tangent = mat3(u_model) * a_tangent;
        v__bitangent = mat3(u_model) * a_bitangent;
        // Ren'Py includes the camera's default center and Z offset in its projection.
        v__eye = u_view_OP_inverse * (u_projection_OP_inverse * vec4(0.0, 0.0, 1.0, 0.0));
        if (u_gltf_orthographic_camera > 0.5) v__eye = u_view_OP_inverse * vec4(0.0, 0.0, 1.0, 0.0);
    """, fragment_functions=_gltf_brdf_functions + """
        vec2 l__uv(float coord, vec3 row0, vec3 row1) {
            vec3 uv = vec3(mix(v__uv0, v__uv1, coord), 1.0);
            return vec2(dot(row0, uv), dot(row1, uv));
        }
        vec2 l__environment_uv(vec2 uv, float band, float page) {
            vec2 tile_size = u_tex_environment_OP_res / vec2(u_gltf_environment_pages, 8.0);
            uv = clamp(uv, 0.5 / tile_size, vec2(1.0) - 0.5 / tile_size);
            return (uv + vec2(page, band)) / vec2(u_gltf_environment_pages, 8.0);
        }
        vec3 l__environment_page(vec3 direction, float band, float page, float rotation) {
            direction = normalize(direction);
            float c = cos(rotation), s = sin(rotation);
            vec3 d = vec3(c * direction.x - s * direction.z, direction.y, s * direction.x + c * direction.z);
            vec2 uv = l__sphere_uv(d);
            uv.x = fract(uv.x);
            vec3 color = texture(u_tex_environment, l__environment_uv(uv, band, page)).rgb;
            float edge = min(uv.x, 1.0 - uv.x);
            float width = u_tex_environment_OP_res.x / u_gltf_environment_pages;
            if (edge * width < 0.5) {
                uv.x = 1.0 - uv.x;
                color = mix(texture(u_tex_environment, l__environment_uv(uv, band, page)).rgb, color, 0.5 + edge * width);
            }
            return color;
        }
        vec3 l__environment(vec3 direction, float band) {
            vec3 probes = vec3(0.0);
            float total = 0.0;
            for (int i = 0; i < 2; ++i) {
                if (float(i) >= u_gltf_probe_count) break;
                vec3 lower = v__position - u_gltf_probe_min[i].xyz;
                vec3 upper = u_gltf_probe_max[i].xyz - v__position;
                float edge = min(min(min(lower.x, lower.y), lower.z), min(min(upper.x, upper.y), upper.z));
                if (edge < 0.0) continue;
                float weight = u_gltf_probe_min[i].w > 0.0 ? clamp(edge / u_gltf_probe_min[i].w, 0.0, 1.0) : 1.0;
                vec3 corrected = direction;
                if (band < 5.5) {
                    vec3 safe = mix(vec3(-1.0), vec3(1.0), step(vec3(0.0), direction)) * max(abs(direction), vec3(0.00001));
                    vec3 far_plane = max(-lower / safe, upper / safe);
                    float distance = min(min(far_plane.x, far_plane.y), far_plane.z);
                    corrected = v__position + direction * distance - u_gltf_probe_origin[i].xyz;
                }
                probes += weight * u_gltf_probe_max[i].w * l__environment_page(corrected, band, float(i + 1), u_gltf_probe_origin[i].w);
                total += weight;
            }
            vec3 global = l__environment_page(direction, band, 0.0, u_gltf_environment_rotation);
            return global * max(1.0 - total, 0.0) + probes / max(total, 1.0);
        }
        vec3 l__shadow_sample(int index, float nl, int cascade, vec3 world_dx, vec3 world_dy) {
            vec4 data = u_gltf_shadow_data[index];
            if (data.x < 0.0 || u_material_receive_shadows < 0.5) return vec3(1.0);
            vec2 uv;
            float depth;
            float bias_scale = 1.0;
            float tile = data.x;
            vec3 dx, dy;
            if (u_gltf_light_positions[index].w > 0.5 && data.z == 0.0) {
                vec3 d = v__position - u_gltf_light_positions[index].xyz;
                vec3 ad = abs(d);
                vec2 face;
                float major;
                vec3 axis_u, axis_v, axis_z;
                if (ad.x >= ad.y && ad.x >= ad.z) {
                    tile += d.x > 0.0 ? 0.0 : 1.0;
                    face = vec2(d.x > 0.0 ? -d.z : d.z, -d.y);
                    major = ad.x;
                    axis_u = vec3(0.0, 0.0, d.x > 0.0 ? -1.0 : 1.0);
                    axis_v = vec3(0.0, -1.0, 0.0);
                    axis_z = vec3(d.x > 0.0 ? 1.0 : -1.0, 0.0, 0.0);
                } else if (ad.y >= ad.z) {
                    tile += d.y > 0.0 ? 2.0 : 3.0;
                    face = vec2(d.x, d.y > 0.0 ? d.z : -d.z);
                    major = ad.y;
                    axis_u = vec3(1.0, 0.0, 0.0);
                    axis_v = vec3(0.0, 0.0, d.y > 0.0 ? 1.0 : -1.0);
                    axis_z = vec3(0.0, d.y > 0.0 ? 1.0 : -1.0, 0.0);
                } else {
                    tile += d.z > 0.0 ? 4.0 : 5.0;
                    face = vec2(d.z > 0.0 ? d.x : -d.x, -d.y);
                    major = ad.z;
                    axis_u = vec3(d.z > 0.0 ? 1.0 : -1.0, 0.0, 0.0);
                    axis_v = vec3(0.0, -1.0, 0.0);
                    axis_z = vec3(0.0, 0.0, d.z > 0.0 ? 1.0 : -1.0);
                }
                uv = face / max(major, 0.000001) * 0.5 + 0.5;
                depth = length(d) / data.y;
                dx = vec3(0.5 * (vec2(dot(world_dx, axis_u), dot(world_dx, axis_v)) * major -
                    face * dot(world_dx, axis_z)) / max(major * major, 0.000000000001),
                    dot(d, world_dx) / max(length(d) * data.y, 0.000000000001));
                dy = vec3(0.5 * (vec2(dot(world_dy, axis_u), dot(world_dy, axis_v)) * major -
                    face * dot(world_dy, axis_z)) / max(major * major, 0.000000000001),
                    dot(d, world_dy) / max(length(d) * data.y, 0.000000000001));
            } else {
                mat4 matrix = u_gltf_shadow_matrices[index];
                #ifdef GLTF_CASCADES
                    if (cascade > 0) matrix = u_gltf_cascade_matrices[index * 3 + cascade - 1];
                    tile += float(cascade);
                #endif
                vec4 clip = matrix * vec4(v__position, 1.0);
                if (clip.w <= 0.0) return vec3(1.0);
                vec3 projected = clip.xyz / clip.w * 0.5 + 0.5;
                vec4 clip_dx = matrix * vec4(world_dx, 0.0), clip_dy = matrix * vec4(world_dy, 0.0);
                // Analytic derivatives stay valid across per-pixel cascade and cube-face branches.
                dx = 0.5 * (clip_dx.xyz * clip.w - clip.xyz * clip_dx.w) / (clip.w * clip.w);
                dy = 0.5 * (clip_dy.xyz * clip.w - clip.xyz * clip_dy.w) / (clip.w * clip.w);
                uv = projected.xy;
                depth = projected.z;
                if (u_gltf_light_positions[index].w > 1.5) {
                    bias_scale = data.z * data.y * data.y / max((data.y - data.z) * clip.w * clip.w, 0.000001);
                }
            }
            if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) || depth > 1.0 || depth < 0.0) return vec3(1.0);
            vec2 grid = u_gltf_shadow_atlas.xy;
            // Half-tile offset keeps exact multiples of the column count off the rounding edge of GPU division.
            float row = floor((tile + 0.5) / grid.x);
            vec2 tile_origin = vec2(tile - row * grid.x, row);
            float size = u_gltf_shadow_atlas.z;
            float determinant = dx.x * dy.y - dx.y * dy.x;
            vec2 gradient = vec2(0.0);
            if (abs(determinant) > 0.000000000001) {
                gradient = vec2(dx.z * dy.y - dy.z * dx.y, dy.z * dx.x - dx.z * dy.x) / determinant;
            }
            depth -= max(data.w * bias_scale * (1.0 + 2.0 * (1.0 - nl)), 0.0000002);
            vec3 visible = vec3(0.0);
            for (int y = -1; y <= 1; ++y) {
                for (int x = -1; x <= 1; ++x) {
                    vec2 pixel = clamp(uv * size + vec2(float(x), float(y)), vec2(0.5), vec2(size - 0.5));
                    vec2 atlas_uv = (tile_origin + pixel / size) / grid;
                    float stored = texture(u_gltf_shadow, atlas_uv).r;
                    float receiver = depth + dot(gradient, (floor(pixel) + 0.5) / size - uv);
                    vec3 tint = vec3(1.0);
                    #ifdef GLTF_COLORED_SHADOWS
                        for (int layer = 0; layer < 2; ++layer) {
                            vec2 glass_uv = vec2(atlas_uv.x, (atlas_uv.y + float(layer)) * 0.5);
                            if (texture(u_gltf_glass_depth, glass_uv).r < receiver)
                                tint *= texture(u_gltf_glass_color, glass_uv).rgb;
                        }
                    #endif
                    #ifdef GLTF_CAUSTICS
                        if (stored < 1.0 && abs(receiver - stored) < max(data.w * bias_scale * 5.0, 0.00005))
                            tint = clamp(tint + texture(u_gltf_caustics, atlas_uv).rgb, vec3(0.0), vec3(4.0));
                    #endif
                    visible += receiver <= stored ? tint : vec3(0.0);
                }
            }
            return visible / 9.0;
        }
        vec3 l__shadow(int index, float nl, vec3 world_dx, vec3 world_dy) {
            #ifdef GLTF_CASCADES
                if (u_gltf_light_positions[index].w < 0.5) {
                    float depth = dot(v__position - u_gltf_cascade_eye, u_gltf_cascade_forward);
                    if (depth < u_gltf_cascade_near || depth > u_gltf_cascade_splits[int(u_gltf_cascade_count) - 1]) return vec3(1.0);
                    float lower = u_gltf_cascade_near;
                    for (int level = 0; level < 4; ++level) {
                        if (float(level) >= u_gltf_cascade_count) break;
                        float upper = u_gltf_cascade_splits[level];
                        if (depth <= upper) {
