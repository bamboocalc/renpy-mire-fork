    _gltf_output_functions = """
        vec4 gltf_scene_output(vec4 color, float exposure, float tone_mapping) {
            vec3 linear_rgb = max(color.rgb / max(color.a, 0.00001), vec3(0.0)) * exposure;
            linear_rgb = min(linear_rgb, vec3(1.0e20));
            // Without tone mapping, display-referred input such as decoded baked sRGB is only clipped.
            linear_rgb = tone_mapping > 0.5 ? linear_rgb / (vec3(1.0) + linear_rgb) : min(linear_rgb, vec3(1.0));
