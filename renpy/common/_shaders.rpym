        vec3 N = vec3(sin(latitude) * cos(longitude), -cos(latitude), sin(latitude) * sin(longitude));
        vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
        vec3 T = normalize(cross(up, N));
        mat3 basis = mat3(T, cross(N, T), N);
        vec3 sum = vec3(0.0);
